@startuml
class Calibration
interface ParamSampler {
    sample(): TabuSearchConfig
}
class TabuSearchConfig {
    iteration_stop: IterationStop
    tenure: TabuTenure
    stop_criteria: tuple[StopCriterion, ...]
}
class Instance
class TabuSearch

class CalibrationResult {
    mean_gap: float
}

Calibration --> ParamSampler : amostra
ParamSampler ..> TabuSearchConfig : retorna
TabuSearch --> TabuSearchConfig : usa
Calibration --> Instance : avalia em
Calibration ..> TabuSearch : executa com cada\nconfiguração
Calibration ..> CalibrationResult : retorna
CalibrationResult --> TabuSearchConfig : configuração vencedora
@enduml
