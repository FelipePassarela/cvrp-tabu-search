@startuml

object "TabuSearch" as tabu {
    tenure: TabuTenure
    solve(instance, seed=None): SearchResult | None
}
object "SearchResult" as result {
    best_cost: int
    completed_iterations: int
}
object "Instance" as inst {
    capacity: int
    vehicle_count: int
}

object "Move" as move
object "InversionMove" as invmo
object "ReallocationMove" as remo
object "ExchangeMove" as smove
object "Neighbourhood" as neigh

object "TabuMemory" as tlist {
    register(keys, iteration, tenure)
    is_tabu(keys, iteration)
    discard_expired(iteration)
}
object "TabuTenure" as tenure {
    minimum: int
    maximum: int
}
object "TabuKey" as tkey

object "StopCriterion" as stop
object "IterationStop" as istop {
    max_iterations: int
}
object "StagnationStop" as stagstop {
    stagnation_limit: int
}
object "SearchProgress" as progress {
    best_cost: int
    completed_iterations: int
    iterations_without_improvement: int
}

object "Client" as client {
    int demand
    Vector2 coord
}
object "Depot" as depot {
    id: int
    coord_x: float
    coord_y: float
}
object "Route" as rote
object "Vehicle" as vehi {
    int capacity
}

object "Solution" as sol
object "FirstFitSolutionGenerator" as solgen
object "SolutionEvaluator" as eval

inst *-- "0..*" client
inst *-- "1" depot
tabu --> inst : otimiza
tabu ..> result : retorna
result --> sol : melhor solução

smove --|> move
remo --|> move
invmo --|> move
move ..> sol : altera
neigh o-- move : cria e retorna\nadmissiveis
tabu ..> move : avalia
tabu ..> neigh : consulta

istop --|> stop
stagstop --|> stop
stop ..> progress : consulta
tabu ..> progress : atualiza
tabu --> "0..*" stop : critérios adicionais
tabu --> "1" istop : limita iterações

rote o-- "0..*" client
vehi --> rote

sol o-- "0..*" vehi
solgen ..> sol : gera
solgen ..> inst : consulta
eval ..> sol : avalia
eval ..> depot : usa
tabu ..> solgen : gera solução inicial
tabu ..> eval : calcula custos

move ..> tkey : produz
tlist o-- "0..*" tkey : bloqueia temporariamente
tabu --> tlist : popula
tabu --> tenure : obtém duração tabu

@enduml
